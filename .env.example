# CMS-API (Scheduling-API, z. B. https://graphql-proxy-staging.redbull.com/api/scheduling/v1/stv
# - ohne "/products/{id}" am Ende, das hängt der Client pro Asset an).
# CMS_API_BASE_URL ist erforderlich, ohne sie läuft eine ID-Präfix-Heuristik als Platzhalter.
# CMS_API_KEY ist optional - die Staging-API ist bisher ohne Bearer-Token erreichbar; wird
# nur als Authorization-Header mitgeschickt, falls gesetzt.
CMS_API_BASE_URL=
CMS_API_KEY=

# Login für Team Processing.
# TEAM_PASSWORD_HASH ist ein bcrypt-Hash, NICHT das Klartext-Passwort.
# Hash erzeugen: node -e "console.log(require('bcryptjs').hashSync('DEIN_PASSWORT', 10))"
# Login ist deaktiviert, solange eine dieser drei Variablen fehlt.
TEAM_USERNAME=
TEAM_PASSWORD_HASH=
SESSION_SECRET=

# Google-Indexierungs-Checker
# Custom Search JSON API (https://developers.google.com/custom-search/v1/overview) -
# eigenes Google-Cloud-Projekt + "Programmable Search Engine" (auf "gesamtes Web
# durchsuchen" gestellt), kein Drittanbieter. 100 Anfragen/Tag sind kostenlos; der
# Code erzwingt dieses Limit selbst (lib/indexing-checker/pipeline.ts).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Beliebiger langer Zufallsstring, schützt /api/indexing-checker/poll (wird vom
# Coolify Scheduled Task als "Authorization: Bearer <Wert>" mitgeschickt).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INDEXING_POLL_SECRET=
# Pfad zur JSON-Speicherdatei. Muss auf ein Coolify Persistent-Storage-Volume zeigen,
# sonst gehen alle Daten bei jedem Redeploy verloren. Default: ./data/indexing-checker.json
INDEXING_DB_PATH=
