# CMS-API (Scheduling-API, z. B. https://graphql-proxy.redbull.com/api/scheduling/v1/stv
# - ohne "/products/{id}" am Ende, das hängt der Client pro Asset an).
# CMS_API_BASE_URL ist erforderlich, ohne sie läuft eine ID-Präfix-Heuristik als Platzhalter.
# CMS_API_KEY ist optional - die API ist bisher ohne Bearer-Token erreichbar; wird
# nur als Authorization-Header mitgeschickt, falls gesetzt.
CMS_API_BASE_URL=
CMS_API_KEY=

# Login für Team Processing.
# TEAM_PASSWORD_HASH ist ein bcrypt-Hash, NICHT das Klartext-Passwort.
# Hash erzeugen: node -e "console.log(require('bcryptjs').hashSync('DEIN_PASSWORT', 10))"
# Login ist deaktiviert, solange eine dieser drei Variablen fehlt.
TEAM_USERNAME=
TEAM_PASSWORD_HASH=
SESSION_SECRET=

# Google-Indexierungs-Checker
# Serper.dev (https://serper.dev) - Drittanbieter-SERP-API auf Basis echter
# Google-Suchergebnisse. Ersetzt die Google Custom Search JSON API (für
# Neukunden geschlossen, wird zum 1.1.2027 komplett eingestellt; Googles
# empfohlener Ersatz "Vertex AI Search" durchsucht nicht den öffentlichen
# Webindex und war daher keine echte Alternative). 2.500 Anfragen einmalig
# kostenlos, danach Bruchteile von Cent/Anfrage. Ein Sicherheits-Tageslimit
# erzwingt der Code selbst (lib/indexing-checker/pipeline.ts).
SERPER_API_KEY=
# Beliebiger langer Zufallsstring, schützt /api/indexing-checker/poll (wird vom
# Coolify Scheduled Task als "Authorization: Bearer <Wert>" mitgeschickt).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INDEXING_POLL_SECRET=
# Pfad zur JSON-Speicherdatei. Muss auf ein Coolify Persistent-Storage-Volume zeigen,
# sonst gehen alle Daten bei jedem Redeploy verloren. Default: ./data/indexing-checker.json
INDEXING_DB_PATH=

# Google-Indexierungs-Checker (Search Console) - parallele Variante zum
# Serper-basierten Checker oben, T2 läuft hier über die offizielle Search
# Console URL Inspection API. Voraussetzung: ein Service-Account mit
# aktivierter Search Console API, dessen E-Mail-Adresse in der Search
# Console als Nutzer (mind. "Eingeschränkt") zur Property hinzugefügt wurde.
# GSC_SERVICE_ACCOUNT_PRIVATE_KEY kommt aus dem Service-Account-JSON-Key
# ("private_key"-Feld) - Zeilenumbrüche als literale "\n" eintragen, der
# Code wandelt sie zurück in echte Newlines um.
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
# Die geprüfte Property, z. B. "sc-domain:servustv.com" oder eine exakte
# URL-Property wie "https://www.servustv.com/" (Format wie im Search-Console-
# Property-Dropdown).
GSC_SITE_URL=
# Eigenes Secret für /api/indexing-checker-gsc/poll, unabhängig von
# INDEXING_POLL_SECRET - beide Checker laufen komplett getrennt.
INDEXING_GSC_POLL_SECRET=
# Eigene JSON-Speicherdatei, unabhängig von INDEXING_DB_PATH. Muss ebenfalls
# auf ein Persistent-Storage-Volume zeigen. Default: ./data/indexing-checker-gsc.json
INDEXING_GSC_DB_PATH=
